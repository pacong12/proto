{
  "name": "@goton/source",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "source-map-js": "^1.2.2"
  },
  "scripts": {
    "prepare": "sh scripts/setup-git-hooks.sh || true",
    "lint": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t typecheck",
    "test": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t test --exclude=contracts",
    "test:contracts": "NX_LOAD_DOT_ENV_FILES=false nx run contracts:test",
    "test:e2e": "NX_LOAD_DOT_ENV_FILES=false nx run @goton/frontoffice:e2e",
    "test:load": "bun run scripts/load-test.ts",
    "test:smoke": "bun run scripts/smoke.ts",
    "deploy:local": "cd contracts && forge script script/robinhood/DeployRobinhoodV2.s.sol --rpc-url http://127.0.0.1:8545 --broadcast",
    "deploy:robinhood": "cd contracts && forge script script/robinhood/DeployRobinhoodV2.s.sol --rpc-url https://rpc.mainnet.chain.robinhood.com --broadcast",
    "deploy:arc": "cd contracts && forge script script/arc/DeployArc.s.sol --rpc-url https://rpc.mainnet.arc.io --broadcast",
    "build": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t build --exclude=contracts",
    "ci": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t lint typecheck test build",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,vue}\"",
    "format:write": "prettier --write \"**/*.{ts,js,json,md,vue}\"",
    "audit:i18n": "bun run scripts/audit-i18n.mjs",
    "commitlint": "commitlint",
    "nx": "NX_LOAD_DOT_ENV_FILES=false nx"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "autocannon": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nx": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "viem": "^2.57.10"
  },
  "nx": {
    "includedScripts": []
  }
}

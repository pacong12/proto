{
  "name": "@proto/source",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:contracts": "cd contracts && forge test",
    "deploy:local": "cd contracts && forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast",
    "deploy:robinhood": "cd contracts && forge script script/Deploy.s.sol --rpc-url https://rpc.mainnet.chain.robinhood.com --broadcast",
    "build": "bun run --filter '*' build",
    "ci": "bun run lint && bun run typecheck && bun run test && bun run test:contracts && bun run build",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,vue}\"",
    "format:write": "prettier --write \"**/*.{ts,js,json,md,vue}\"",
    "audit:i18n": "bun run scripts/audit-i18n.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "viem": "^2.23.0"
  }
}

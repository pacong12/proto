{
  "name": "@proto/source",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:contracts": "cd contracts && forge test",
    "build": "npm run --workspaces --if-present build",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run test:contracts && npm run build",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,sol}\"",
    "format:write": "prettier --write \"**/*.{ts,js,json,md,sol}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nx/devkit": "^20.4.0",
    "@nx/eslint": "^20.4.0",
    "@nx/js": "^20.4.0",
    "@nx/nest": "^20.4.0",
    "@nx/node": "^20.4.0",
    "@nx/vite": "^20.4.0",
    "@nx/vue": "^20.4.0",
    "@nx/web": "^20.4.0",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "nx": "^20.4.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "viem": "^2.23.0"
  }
}

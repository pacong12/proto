FROM oven/bun:1-alpine AS base
WORKDIR /app

# Copy root manifests and workspace package manifests
COPY package.json bun.lock ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api/package.json ./apps/api/
# Stub other workspaces so bun install resolves the full workspace graph
COPY apps/frontoffice/package.json ./apps/frontoffice/
COPY apps/docs/package.json ./apps/docs/

RUN bun install --frozen-lockfile

# Copy source files
COPY tsconfig.base.json ./
COPY packages/shared-types ./packages/shared-types
COPY apps/api ./apps/api

EXPOSE 3001
ENV PORT=3001
ENV NODE_ENV=production

# Health check using wget (available in alpine)
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3001/health || exit 1

COPY apps/api/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh \
  && mkdir -p /app/data \
  && chmod 777 /app/data

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["bun", "run", "apps/api/src/server.ts"]

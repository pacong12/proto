FROM oven/bun:1-alpine AS base
WORKDIR /app

# Copy root manifests and workspace package manifests
COPY package.json bun.lock ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/contracts-abi/package.json ./packages/contracts-abi/
COPY packages/math-sdk/package.json ./packages/math-sdk/
COPY apps/api/package.json ./apps/api/
# Stub other workspaces so bun install resolves the full workspace graph
COPY apps/frontoffice/package.json ./apps/frontoffice/
COPY apps/docs/package.json ./apps/docs/

RUN bun install --frozen-lockfile

# Copy source files
COPY tsconfig.base.json ./
COPY packages/shared-types ./packages/shared-types
COPY packages/contracts-abi ./packages/contracts-abi
COPY packages/math-sdk ./packages/math-sdk
COPY apps/api ./apps/api
# Ops: re-index a range or recover missed curve trades (docker exec proto-api bun run scripts/backfill-tokens.ts ...).
COPY scripts/backfill-tokens.ts ./scripts/backfill-tokens.ts

EXPOSE 3001
ENV PORT=3001
ENV NODE_ENV=production
# Writable state lives on the data volume (the app runs as the unprivileged `bun` user).
ENV DB_PATH=/app/data/proto.sqlite
ENV UPLOADS_DIR=/app/data/uploads

# Health check using wget (available in alpine)
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/health || exit 1

# DEVOPS-05: the API runs as the unprivileged `bun` user. The entrypoint starts as root only to
# fix ownership of volumes created by older (root) images, then drops privileges via su-exec.
RUN apk add --no-cache su-exec sqlite
COPY apps/api/entrypoint.sh /app/entrypoint.sh
RUN chmod 755 /app/entrypoint.sh \
  && mkdir -p /app/data \
  && chown -R bun:bun /app/data \
  && chmod 750 /app/data

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["bun", "run", "apps/api/src/server.ts"]

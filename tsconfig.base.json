{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": false,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "paths": {
      "@goton/shared-types": ["./packages/shared-types/src/index.ts"],
      "@goton/contracts": ["./packages/contracts/src/index.ts"],
      "@goton/contracts-abi": ["./packages/contracts-abi/src/index.ts"],
      "@goton/math-sdk": ["./packages/math-sdk/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}

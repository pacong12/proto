# ==============================================================================
# PROTO PROTOCOL ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in all values.
# Never commit .env to version control.
# ==============================================================================

# 1. Deployer wallet configuration
# Set your deployment private key here (do not commit real keys).
PRIVATE_KEY=

# 2. Network configuration (Robinhood Chain ID: 4663)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
BLOCK_EXPLORER_URL=https://robinhoodchain.blockscout.com

# 3. Uniswap V3 infrastructure contracts
V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
POSITION_MANAGER=0x73991a25C818Bf1f1128dEAaB1492D45638DE0D3
SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
QUOTER_V2=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# 4. Protocol deployments and treasury
LAUNCHPAD_FACTORY_ADDRESS=0x48844223aBDceeb1Ce502F54d559681358E68200
LIQUIDITY_LOCKER_ADDRESS=0x070233B6F46ccD61CA2B7bc1E13520c3fE4614E4
PROTOCOL_FEE_RECIPIENT=

# 5. Economic parameters
POOL_FEE_TIER=10000
LAUNCH_FEE_WEI=500000000000000
GRADUATION_THRESHOLD_WEI=4200000000000000000
PROTOCOL_FEE_SHARE_PERCENT=30
CREATOR_FEE_SHARE_PERCENT=70

# 6. IPFS and storage
IPFS_GATEWAY=https://ipfs.io/ipfs/
PINATA_JWT=

# 7. Backend API server
API_PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001
# Comma-separated list of allowed CORS origins. Leave empty to allow all (development only).
CORS_ALLOWED_ORIGINS=https://proto.family,https://app.proto.family

# 8. Reown AppKit wallet modal - register at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# 9. Price feed and oracle
PRICE_FEED_MODE=coingecko
COINGECKO_API_KEY=

# 10. Redis cache
REDIS_URL=redis://localhost:6379

VITE_ARC_V3_FACTORY=0xf0db7b58379503491d857dB50AC9ece64c653918
ARC_POSITION_MANAGER=0x39654A85A4C05127f5Fd6ED22CAeC077A0fB1377
VITE_ARC_POSITION_MANAGER=0x39654A85A4C05127f5Fd6ED22CAeC077A0fB1377
ARC_SWAP_ROUTER=0x53BF6B0684Ec7eF91e1387Da3D1a1769bC5A6F77
VITE_ARC_SWAP_ROUTER=0x53BF6B0684Ec7eF91e1387Da3D1a1769bC5A6F77
ARC_QUOTER_V2=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
VITE_ARC_QUOTER_V2=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
ARC_WETH_ADDRESS=0x3600000000000000000000000000000000000000
VITE_ARC_WETH_ADDRESS=0x3600000000000000000000000000000000000000

# Arc Economic Parameters
ARC_LAUNCH_FEE_WEI=1000000000000000000
VITE_ARC_LAUNCH_FEE_WEI=1000000000000000000
ARC_GRADUATION_TARGET_WEI=69000000000000000000000
VITE_ARC_GRADUATION_TARGET_WEI=69000000000000000000000
ARC_GRADUATION_THRESHOLD_WEI=69000000000000000000000
VITE_ARC_GRADUATION_THRESHOLD_WEI=69000000000000000000000

# -----------------------------------------------------------------------------
# Protocol Treasury
# -----------------------------------------------------------------------------
PROTOCOL_FEE_RECIPIENT=0x555C0456641d5ff4Fb47E24D6472b4a16aC1b0c2

# -----------------------------------------------------------------------------
# Backend API Server
# -----------------------------------------------------------------------------
PORT=3011
API_PORT=3011
FRONTOFFICE_PORT=3010
DOCS_PORT=3012
NODE_ENV=production
API_BASE_URL=http://localhost:3011
LOG_LEVEL=info

# SQLite database path (absolute path inside the container; host path when running natively).
DB_PATH=./data/proto.sqlite

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6380
# Default password for redis (can be overridden with custom secret)
REDIS_PASSWORD=proto_redis_default_secure_pass

# -----------------------------------------------------------------------------
# Price Feed
# CoinGecko API key (optional — increases rate limits from 30req/min to 500)
# Get a free key at https://www.coingecko.com/en/api
# -----------------------------------------------------------------------------
COINGECKO_API_KEY=

# -----------------------------------------------------------------------------
# IPFS / Pinata (optional — token images fallback to deterministic CID without)
# Get JWT at https://app.pinata.cloud
# -----------------------------------------------------------------------------
PINATA_JWT=

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed CORS origins for the API server.
# Example: https://app.protocollaunch.xyz,https://www.protocollaunch.xyz
# Leave empty to allow only localhost (development mode).
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Admin & DevOps endpoints
# Both are disabled (403) when the corresponding token is not set.
# Use a strong random string (e.g. openssl rand -hex 32).
# -----------------------------------------------------------------------------
# Protects POST /api/admin/backfill and similar privileged operations.
ADMIN_SECRET=

# Protects /devops, /api/devops/telemetry, and /api/devops/metrics dashboards.
DEVOPS_AUTH_TOKEN=

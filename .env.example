# ==============================================================================
# PROTO PROTOCOL ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite — prefix VITE_ required for browser exposure)
# Register project at https://dashboard.reown.com
# -----------------------------------------------------------------------------
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# Optional: override default API URL for frontoffice (defaults to /api proxy)
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Deployer key (used only by forge scripts, never by the API at runtime)
# -----------------------------------------------------------------------------
PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Robinhood Chain Mainnet (Chain ID: 4663) - Arbitrum Nitro L2
# Native gas: ETH (18 decimals)
# -----------------------------------------------------------------------------
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
VITE_CHAIN_ID=4663
BLOCK_EXPLORER_URL=https://robinhoodchain.blockscout.com
ROBINHOOD_BLOCK_EXPLORER_URL=https://robinhoodchain.blockscout.com
VITE_ROBINHOOD_BLOCK_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Robinhood Smart Contracts

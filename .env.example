# ==============================================================================
# PROTO PROTOCOL ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite — prefix VITE_ required for browser exposure)
# Register project at https://dashboard.reown.com
# -----------------------------------------------------------------------------
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# Optional: override default API URL for frontoffice (defaults to /api proxy)
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Deployer key (used only by forge scripts, never by the API at runtime)
# -----------------------------------------------------------------------------
PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Robinhood Chain Mainnet (Chain ID: 4663)
# -----------------------------------------------------------------------------
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_FACTORY_V2=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# -----------------------------------------------------------------------------
# Arc Network Mainnet (Chain ID: 5042) - Circle Stablecoin L1
# Native gas: USDC (18 decimals, 1 ether = 1.00 USDC)
# -----------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.mainnet.arc.io
# TODO: update to new LaunchpadV2FactoryArc address after re-deploy
ARC_FACTORY_ADDRESS=0x48844223aBDceeb1Ce502F54d559681358E68200
# TODO: update after LiquidityLocker deploy
ARC_LOCKER_ADDRESS=0x0000000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# Protocol Treasury
# -----------------------------------------------------------------------------
PROTOCOL_FEE_RECIPIENT=0x555C0456641d5ff4Fb47E24D6472b4a16aC1b0c2

# -----------------------------------------------------------------------------
# Backend API Server
# -----------------------------------------------------------------------------
PORT=3001
API_PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6380

# -----------------------------------------------------------------------------
# Price Feed
# CoinGecko API key (optional — increases rate limits from 30req/min to 500)
# Get a free key at https://www.coingecko.com/en/api
# -----------------------------------------------------------------------------
COINGECKO_API_KEY=

# -----------------------------------------------------------------------------
# IPFS / Pinata (optional — token images fallback to deterministic CID without)
# Get JWT at https://app.pinata.cloud
# -----------------------------------------------------------------------------
PINATA_JWT=

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins for the API server.
# Example: https://app.protocolaunch.xyz,https://www.protocolaunch.xyz
# Leave empty to allow only localhost (development mode).
CORS_ALLOWED_ORIGINS=

# Redis connection URL for caching and rate-limiting.
REDIS_URL=redis://127.0.0.1:6380

# CoinGecko API key for ETH price feed (optional, falls back to public API).
COINGECKO_API_KEY=

# Admin endpoint secret for POST /api/admin/backfill and similar protected routes.
# Must be a strong random string. Leave empty to disable admin endpoints.
ADMIN_SECRET=

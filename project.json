{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "@goton/source",
  "//": "The edge worker (worker.ts, seo.ts), its tests in tests/ and repo tooling outside apps/ and packages/.",
  "targets": {
    "lint": {
      "command": "eslint . --max-warnings=0 --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
      "cache": true
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/worker.ts",
        "{workspaceRoot}/seo.ts",
        "{workspaceRoot}/tests/**/*",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "test": {
      "command": "vitest run tests",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/worker.ts",
        "{workspaceRoot}/seo.ts",
        "{workspaceRoot}/tests/**/*",
        "{workspaceRoot}/vitest.config.ts",
        "{workspaceRoot}/apps/frontoffice/public/**/*",
        "{workspaceRoot}/apps/docs/src/public/**/*"
      ]
    }
  }
}

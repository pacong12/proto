# Security headers (CSP, HSTS, frame and referrer policy) are set by worker.ts, which runs first for
# every request (run_worker_first in wrangler.toml). This file only tunes caching.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/logo-*.svg
  Content-Disposition: inline
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=31536000, immutable
